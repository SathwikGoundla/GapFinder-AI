# ---- Supabase (https://supabase.com/dashboard → Project Settings → API) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Used ONLY by scripts/seed-demo.mjs to create the demo user. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- AI provider (any OpenAI-compatible API) ----
# Option A — Google Gemini (free tier): https://aistudio.google.com/apikey
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=your-ai-api-key
AI_CHAT_MODEL=gemini-2.5-flash
AI_EMBEDDING_MODEL=gemini-embedding-001
# Must match the vector(...) size in supabase/migrations/0001_init.sql
AI_EMBEDDING_DIMENSIONS=768
# Option B — OpenAI: AI_BASE_URL=https://api.openai.com/v1, AI_CHAT_MODEL=gpt-4o-mini,
#   AI_EMBEDDING_MODEL=text-embedding-3-small, AI_EMBEDDING_DIMENSIONS=768

# ---- RAG tuning (optional; defaults shown) ----
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=6
RAG_MIN_SIMILARITY=0.55

# ---- Demo account (used by scripts/seed-demo.mjs; choose your own values) ----
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=change-me-to-a-long-random-password
DEMO_LOGIN_ENABLED=false
